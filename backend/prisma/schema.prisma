generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileType {
  BUYER
  SUPPLIER
}

model User {
  id          String    @id @default(uuid())
  phoneNumber String    @unique
  name        String?
  createdAt   DateTime  @default(now())
  profiles    Profile[]
}

model Profile {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  phoneNumber String
  companyName String
  profileType ProfileType
  gstNumber   String?
  logoUrl     String?
  createdAt   DateTime    @default(now())

  groupsOwned      Group[]         @relation("BuyerGroups")
  groupMemberships GroupSupplier[]

  @@unique([phoneNumber, companyName, profileType])
}

model Group {
  id             String   @id @default(uuid())
  buyerProfileId String
  buyerProfile   Profile  @relation("BuyerGroups", fields: [buyerProfileId], references: [id])
  name           String
  description    String?
  imageUrl       String?
  createdAt      DateTime @default(now())

  suppliers GroupSupplier[]
}

model GroupSupplier {
  id                String   @id @default(uuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id])
  phoneNumber       String
  contactName       String?
  supplierProfileId String?
  supplierProfile   Profile? @relation(fields: [supplierProfileId], references: [id])
  addedAt           DateTime @default(now())

  @@unique([groupId, phoneNumber])
}
