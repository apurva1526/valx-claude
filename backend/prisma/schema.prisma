generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileType {
  BUYER
  SUPPLIER
}

model User {
  id              String       @id @default(uuid())
  phoneNumber     String       @unique
  name            String?
  createdAt       DateTime     @default(now())
  profiles        Profile[]
  teamMemberships TeamMember[]
}

model Profile {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  phoneNumber   String
  companyName   String
  profileType   ProfileType
  gstNumber     String?
  logoUrl       String?
  createdAt     DateTime    @default(now())
  deactivatedAt DateTime?

  groupsOwned      Group[]         @relation("BuyerGroups")
  groupMemberships GroupSupplier[]
  bidsCreated      Bid[]
  bidResponses     BidResponse[]
  notifications    Notification[]
  awardsClosedBy   AwardRecord[]
  teamMembers      TeamMember[]
  pins             Pin[]
  pushTokens       PushToken[]

  @@unique([phoneNumber, companyName, profileType])
}

model Group {
  id             String   @id @default(uuid())
  buyerProfileId String
  buyerProfile   Profile  @relation("BuyerGroups", fields: [buyerProfileId], references: [id])
  name           String
  description    String?
  imageUrl       String?
  createdAt      DateTime @default(now())

  suppliers        GroupSupplier[]
  bids             Bid[]
  teamMemberScopes TeamMember[]
}

enum BidStatus {
  ONGOING
  CLOSED
}

enum Currency {
  INR
  USD
}

model Bid {
  id                  String    @id @default(uuid())
  groupId             String
  group               Group     @relation(fields: [groupId], references: [id])
  title               String
  description         String
  targetPrice         Float?
  targetPriceCurrency Currency  @default(INR)
  validityDeadline    DateTime
  status              BidStatus @default(ONGOING)
  createdByProfileId  String
  createdByProfile    Profile   @relation(fields: [createdByProfileId], references: [id])
  createdAt           DateTime  @default(now())
  deadlineAlertSentAt DateTime?

  responses     BidResponse[]
  notifications Notification[]
  awardRecord   AwardRecord?
}

model AwardRecord {
  id                 String   @id @default(uuid())
  bidId              String   @unique
  bid                Bid      @relation(fields: [bidId], references: [id])
  awardedSupplierIds String[]
  supplierComments   Json?
  averagePrice       Float?
  closedByProfileId  String
  closedByProfile    Profile  @relation(fields: [closedByProfileId], references: [id])
  closedAt           DateTime @default(now())
}

enum NotificationType {
  BID_EDITED
  BID_CREATED
  BID_CLOSED
  BID_DEADLINE_APPROACHING
  BID_RESPONSE_SUBMITTED
  ADDED_TO_GROUP
  NEW_CHAT_MESSAGE
  PROFILE_DEACTIVATED
}

model Notification {
  id                 String           @id @default(uuid())
  recipientProfileId String
  recipientProfile   Profile          @relation(fields: [recipientProfileId], references: [id])
  type               NotificationType
  message            String
  bidId              String?
  bid                Bid?             @relation(fields: [bidId], references: [id])
  createdAt          DateTime         @default(now())
  readAt             DateTime?
}

model BidResponse {
  id                String    @id @default(uuid())
  bidId             String
  bid               Bid       @relation(fields: [bidId], references: [id])
  supplierProfileId String
  supplierProfile   Profile   @relation(fields: [supplierProfileId], references: [id])
  price             Float
  comment           String?
  revisionNumber    Int       @default(1)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  revisions BidResponseRevision[]

  @@unique([bidId, supplierProfileId])
}

model BidResponseRevision {
  id             String      @id @default(uuid())
  bidResponseId  String
  bidResponse    BidResponse @relation(fields: [bidResponseId], references: [id])
  price          Float
  comment        String?
  revisionNumber Int
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
}

model GroupSupplier {
  id                String   @id @default(uuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id])
  phoneNumber       String
  contactName       String?
  supplierProfileId String?
  supplierProfile   Profile? @relation(fields: [supplierProfileId], references: [id])
  addedAt           DateTime @default(now())

  @@unique([groupId, phoneNumber])
}

enum AccessLevel {
  VIEW
  EDIT
  MANAGE
}

model TeamMember {
  id           String      @id @default(uuid())
  profileId    String
  profile      Profile     @relation(fields: [profileId], references: [id])
  phoneNumber  String
  contactName  String?
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  accessLevel  AccessLevel @default(MANAGE)
  scopeGroupId String?
  scopeGroup   Group?      @relation(fields: [scopeGroupId], references: [id])
  createdAt    DateTime    @default(now())

  @@unique([profileId, phoneNumber])
}

enum PinType {
  GROUP
  BID
}

model Pin {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  type      PinType
  targetId  String
  createdAt DateTime @default(now())

  @@unique([profileId, type, targetId])
}

model PushToken {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  token     String
  createdAt DateTime @default(now())

  @@unique([profileId, token])
}

model OtpChallenge {
  phoneNumber String   @id
  sessionId   String
  createdAt   DateTime @default(now())
}
